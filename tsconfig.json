{
	"compilerOptions": {
		"target": "es2020",
		"lib": ["dom", "esnext"],
		"module": "esnext",
		"moduleResolution": "node",
		"allowJs": false,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"baseUrl": "."
	},
	"exclude": ["node_modules"],
	"references": [{ "path": "apps/web" }]
}
