		"@trpc/server": "11.8.0",
		"@vitest/coverage-v8": "3.2.4",
		"cmdk": "1.1.1",
		"csv-parser": "3.2.0",
		"dayjs": "1.11.13",
		"immer": "10.1.1",
		"ldrs": "1.1.7",
		"libphonenumber-js": "1.12.8",
		"motion": "12.38.0",
		"mui-tel-input": "9.0.1",
