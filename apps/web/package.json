{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"test": "vitest",
		"test:integration": "vitest --config vitest.integration.config.ts",
		"test:integration:setup": "tsx src/__tests__/integration/setup-test-db.ts",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"typecheck": "tsc --noEmit",
		"db:migrate": "tsx src/api/database/migrate-to-latest.ts",
		"db:migrate:down": "tsx src/api/database/migrate-down.ts",
		"db:migration:create": "tsx src/api/database/create-migration.ts",
		"db:types": "kysely-codegen --out-file=src/api/database/types.d.ts --dialect=postgres --include-pattern=\"(public|analytics).*\""
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@faker-js/faker": "^9.7.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/papaparse": "5.3.16",
		"@types/pg": "8.15.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/ui": "3.2.4",
		"dotenv": "17.4.2",
		"eslint": "^9",
		"eslint-config-next": "15.3.2",
		"kysely": "^0.27.2",
		"kysely-codegen": "^0.17.0",
		"pdf-parse": "^1.1.1",
		"tailwindcss": "^4",
		"tsx": "^4.19.3",
		"typescript": "^5",
		"vitest": "3.2.4"
	},
	"dependencies": {
		"@fontsource/inter": "5.2.6",
		"@supabase/ssr": "0.12.0",
		"@supabase/supabase-js": "2.108.1",
		"@tabler/icons-react": "^3.31.0",
		"@tanstack/react-query": "5.90.16",
		"@tanstack/react-query-devtools": "5.91.2",
		"@tanstack/react-table": "8.21.3",
		"@trpc/client": "11.8.0",
		"@trpc/react-query": "11.8.0",
		"@trpc/server": "11.8.0",
		"@vitest/coverage-v8": "3.2.4",
		"cmdk": "1.1.1",
		"csv-parser": "3.2.0",
		"dayjs": "1.11.13",
		"immer": "10.1.1",
		"ldrs": "1.1.7",
		"libphonenumber-js": "1.12.8",
		"motion": "12.38.0",
		"next": "15.3.8",
		"papaparse": "5.5.3",
		"pg": "8.16.0",
		"react": "19.0.0",
		"react-day-picker": "9.14.0",
		"react-dom": "19.0.0",
		"react-dropzone": "14.3.8",
		"react-hook-form": "7.55.0",
		"react-icons": "5.5.0",
		"react-transition-group": "4.4.5",
		"recharts": "3.8.0",
		"resend": "4.6.0",
		"superjson": "2.2.2",
		"uuid": "11.1.0",
		"vite": "6.2.1",
		"zod": "3.24.4",
		"zustand": "5.0.3"
	}
}
