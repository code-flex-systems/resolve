{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"test": "vitest",
		"test:integration": "vitest --config vitest.integration.config.ts",
		"test:integration:setup": "tsx src/__tests__/integration/setup-test-db.ts",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"azurite": "azurite-blob --silent --location ./azurite-data --blobPort 10000",
		"typecheck": "tsc --noEmit",
		"db:migrate:build": "tsup",
		"db:migrate:run": "node dist-migrator/migrate-to-latest.js",
		"db:migrate:down": "tsx src/api/database/migrate-down.ts",
		"db:migration:create": "tsx src/api/database/create-migration.ts",
		"db:types": "kysely-codegen --out-file=src/api/database/types.d.ts --dialect=postgres"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@faker-js/faker": "^9.7.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/papaparse": "5.3.16",
		"@types/pg": "8.15.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/ui": "3.2.4",
		"azurite": "^3.33.0",
		"eslint": "^9",
		"eslint-config-next": "15.3.2",
		"kysely": "^0.27.2",
		"kysely-codegen": "^0.17.0",
		"pdf-parse": "^1.1.1",
		"tailwindcss": "^4",
		"tsup": "8.5.1",
		"tsx": "^4.19.3",
		"typescript": "^5",
		"vitest": "3.2.4"
	},
	"dependencies": {
		"@azure/storage-blob": "12.29.1",
		"@clerk/backend": "2.25.0",
		"@clerk/nextjs": "6.35.6",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.0",
		"@fontsource/inter": "5.2.6",
		"@mui/icons-material": "7.0.0",
		"@mui/material": "7.0.0",
		"@mui/material-nextjs": "7.1.0",
		"@mui/x-charts-pro": "8.9.0",
		"@mui/x-data-grid-pro": "7.28.0",
