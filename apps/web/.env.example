# ============================================================================
# Application
# ============================================================================

# Public URL the app is reachable at (used for redirects, links in emails, etc.)
BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standard Node env. One of: development | production | test
NODE_ENV=development

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
# DATABASE_URL is used by kysely-codegen and migration tooling.
# DB_* values are used by the runtime connection pool. They should agree
# with each other.
#
# For Supabase: use the Session pooler connection (port 5432) values from
# Project Settings -> Database. Run migrations against the direct
# connection (the migrator takes a pg_advisory_lock, which is not
# supported by the transaction-mode pooler on port 6543).

DATABASE_URL=postgres://postgres:password@localhost:5432/resolve

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_DATABASE=resolve
DB_SCHEMA=public
# Set to true to connect with TLS outside production (recommended for Supabase)
DB_SSL=false

# Integration tests use a separate local database via TEST_DB_* (they never
# read DB_*, so they cannot touch the real database). Defaults shown; only
# set these if your local postgres differs.
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=password
# TEST_DB_DATABASE=resolve_test

# ============================================================================
# Supabase (auth + storage)
# ============================================================================
# Get these from the Supabase dashboard: Project Settings -> API.
# The service role key is server-only - never expose it to the browser.
#
# Auth email templates (Authentication -> Emails) must point invite and
# password-recovery links at /auth/confirm, e.g.:
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=invite&next=/auth/set-password
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/auth/set-password
# and the Site URL / redirect allow-list must include this app's URL.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Private storage bucket for documents (created automatically on first use)
SUPABASE_STORAGE_BUCKET=documents

# ============================================================================
# Email (Resend)
# ============================================================================
# Resend is the active provider. Postmark/SES branches in sendEmail.ts are
# stubbed out — only set EMAIL_PROVIDER to one of those if you wire it up.

EMAIL_PROVIDER=resend
EMAIL_FROM=notifications@example.com
RESEND_API_KEY=re_your_resend_api_key_here

