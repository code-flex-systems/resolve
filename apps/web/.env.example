# ============================================================================
# Application
# ============================================================================

# Public URL the app is reachable at (used for redirects, links in emails, etc.)
BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standard Node env. One of: development | production | test
NODE_ENV=development

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
# DATABASE_URL is used by kysely-codegen and migration tooling.
# DB_* values are used by the runtime connection pool. They should agree
# with each other.

DATABASE_URL=postgres://postgres:password@localhost:5432/resolve

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_DATABASE=resolve
DB_SCHEMA=public

# ============================================================================
# Authentication (Clerk)
# ============================================================================
# Get these from the Clerk dashboard for your application:
# https://dashboard.clerk.com/

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# Storage (Azure Blob)
# ============================================================================
# For local dev, point at the bundled Azurite emulator (started via the
# `azurite` script). Use a real connection string in deployed environments.

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER_NAME=documents

# ============================================================================
# Email (Resend)
# ============================================================================
# Resend is the active provider. Postmark/SES branches in sendEmail.ts are
# stubbed out — only set EMAIL_PROVIDER to one of those if you wire it up.

EMAIL_PROVIDER=resend
EMAIL_FROM=notifications@example.com
RESEND_API_KEY=re_your_resend_api_key_here

# ============================================================================
# Third-party licenses
# ============================================================================
# MUI X Pro license key. Read by LicenseInfo.setLicenseKey() at startup.

MUI_KEY=

# ============================================================================
# Feature flags
# ============================================================================

FEATURE_DESK_HIERARCHY=false

# ============================================================================
# CI / external services (optional, only needed in CI)
# ============================================================================

SONAR_TOKEN=
SONAR_ORGANIZATION=
SONAR_PROJECT_KEY=
