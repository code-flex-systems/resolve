# Enforce using the root node_modules folder (workspace installs)
workspaces=true

# Prevent creating lockfiles in child apps/packages
# package-lock=false

# Use a single lockfile at the root
shared-workspace-lock=true

# Ensure consistent installs
strict-peer-dependencies=true

# Optional: always save exact versions (e.g., 1.2.3 instead of ^1.2.3)
save-exact=true
